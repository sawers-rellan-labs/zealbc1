// nilhmm Phase-1 — hazel Slurm config. Pattern from tlaloc/nilhifi (LSF -> Slurm).
// Resources (cpus/memory/time) live in each module, not here. `label` maps conda envs only.

params {
    // ---- inputs (edit) --------------------------------------------------
    // Branch A (BC1 -> per-F1 mask):
    bc1_samplesheet   = "${projectDir}/bc1_samples.csv"     // sample,donor,taxon,fastq_1,fastq_2  (384)
    reference         = "/rsstu/users/r/rrellan/BZea/ref/B73/Zm-B73-REFERENCE-NAM-5.0.fa"  // pre-indexed (minibwa index + faidx)
    sites             = "/rsstu/users/r/rrellan/BZea/bzeaseq/nilhmm/vcf/HQ_BZEA.vcf.gz"       // SNP50K panel (bcftools mpileup -T accepts a VCF)
    // Branch B (existing BC2S3 counts -> exclude non-informative per F1 -> binHMM):
    bc2s3_counts      = "${projectDir}/bc2s3_counts.csv"    // sample,donor,counts  (EXISTING allelic counts under rsstu .../bzeaseq; NOT re-aligned)
    outdir            = "/rsstu/users/r/rrellan/BZea/BC1_nilhmm"  // results sibling of BC1_dna_raw (NOT inside the raw folder)
    // ---- knobs ----------------------------------------------------------
    mapq              = 20
    design            = 'BC2S3'      // nilhmm pedigree token (call_ancestry)
    bin_size          = 1000000      // binhmm bin width (bp)
}

profiles {
    slurm {
        process.executor         = 'slurm'
        process.queue            = 'compute'
        process.clusterOptions   = '-A maize_cpu --qos=normal'
        executor.queueSize       = 80
        executor.submitRateLimit = '10/1min'
    }
    local { process.executor = 'local' }
}

process {
    errorStrategy = 'retry'
    maxRetries    = 1
    beforeScript  = 'source /usr/local/apps/conda/miniconda3/26.3.2/etc/profile.d/conda.sh'

    // small compatible tools share one env; R (heavy) gets its own. Nextflow builds from the yml.
    // To use a prebuilt env instead, swap the yml path for its prefix.
    withLabel: align  { conda = "${projectDir}/envs/assembly.yml" }  // minibwa + samtools
    withLabel: call   { conda = "${projectDir}/envs/assembly.yml" }  // bcftools + htslib
    withLabel: rstats { conda = "/share/maize/frodrig4/conda/env/nilhmm" }  // PREBUILT (nilhmm.yml + install_github nilhmm); not yml-rebuilt
}

conda.enabled = true
workDir       = "${params.outdir}/work"

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }

manifest {
    name            = 'nilhmm-phase1'
    description     = 'BC1 H_d + BC2S3 binHMM dosage (biallelic bzeaseq sites, B73 v5)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
}
