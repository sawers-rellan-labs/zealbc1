// nilhmm Phase-1 — hazel Slurm config. Pattern from tlaloc/nilhifi (LSF -> Slurm).
// Resources (cpus/memory/time) live in each module, not here. `label` maps conda envs only.

params {
    // ---- ZEAL project tree on the BZea partition (built by setup_zeal.sh) ----
    // code (this repo) at $ZEAL/code; data/refs/results are sibling subtrees under $ZEAL.
    // projectDir = $ZEAL/code/nilhmm, so $ZEAL is two levels up.
    zeal              = "${projectDir}/../.."                // /rsstu/users/r/rrellan/BZea/ZEAL
    // ---- inputs (edit) --------------------------------------------------
    // (1) build the mask from the BC1 plants (demux the 32 pools -> per-plant reads):
    bc1_rawdata       = "${params.zeal}/raw/BC1_dna_raw/01.RawData"  // pool dirs (BC1_<pool>[r])
    bc1_libraries     = "${projectDir}/../meta/bc1_libraries.csv"    // pool,raw_dir  (32)
    bc1_well_map      = "${projectDir}/../meta/bc1_well_map.csv"     // (pool,column) -> Sample_Id,donor,taxon  (384)
    bc_fasta          = "${projectDir}/../meta/bc.fasta"             // 12 inline barcodes (named by column)
    reference         = "${params.zeal}/reference/B73.fa"       // symlink; INDEX_REF writes minibwa+faidx here
    sites             = "${params.zeal}/reference/sites.vcf.gz" // SNP50K panel (bcftools mpileup -T accepts a VCF)
    sites_bed         = "${params.zeal}/reference/sites.bed"    // SNP50K sites as BED for mosdepth --by (optional)
    // (1b) BC2S3 batch 2 (--entry demux_bc2s3_batch2): 32 row libraries, 12 inline barcodes each.
    bc2s3_rawdata     = "${params.zeal}/../BC2S3_batch_2_dna_raw/01.RawData"   // <row>/<row>_*_L6_{1,2}.fq.gz
    bc2s3_libraries   = "${projectDir}/../meta/bc2s3_batch2_libraries.csv"    // pool,raw_dir (32)
    bc2s3_well_map    = "${projectDir}/../meta/bc2s3_batch2_well_map.csv"     // pool,column,barcode,Sample_Id(P<Plot_id>),label,nil_id,...,taxon
    samples           = ''           // '' = all; else comma list of Sample_Id to ALIGN (batch-2 entry only)
    entry             = 'bc1_mask'  // which named workflow runs: bc1_mask (default) | demux_bc2s3_batch2 (strict parser: no -entry)
    // (2) call dosage on the EXISTING merged BC2S3 counts (NOT re-aligned/re-counted):
    bc2s3_counts      = "${params.zeal}/reference/allelic_counts50K.tsv" // merged, SAMPLE column
    bc2s3_samples     = "${params.zeal}/meta/bc2s3_samples.csv"          // sample,donor map
    dosage            = false        // opt-in: run BINHMM_DOSAGE (cohort call) — only with ALL donors' masks (full pool set)
    outdir            = "${params.zeal}/results"               // ZEAL/results (data/results separate from code/)
    // ---- knobs ----------------------------------------------------------
    mapq              = 20
    design            = 'BC2S3'      // nilhmm pedigree token (call_ancestry)
    bin_size          = 1000000      // binhmm bin width (bp)
    // ---- testing (Gate 1) ----------------------------------------------
    pools             = ''           // '' = all 32; e.g. '1B' or '1B,2C' restricts the pools demuxed
    subsample         = 0            // 0 = all reads; else first N read pairs per pool (Gate 1)
}

profiles {
    slurm {
        process.executor         = 'slurm'
        process.queue            = 'compute'
        process.clusterOptions   = '-A maize_cpu --qos=normal'
        executor.queueSize       = 80
        executor.submitRateLimit = '10/1min'
        conda.enabled            = true    // activate the prebuilt prefixes (no build on compute)
    }
    // Gate 1 real-tools runs on the debug queue (compute_partners + short QOS, 2h max).
    // A `withName` selector OVERRIDES each module's body `time` (a plain process.time is only a
    // default and does NOT); cap all to 1h so no child violates the 2h QOS cap. Gate 1 is subsampled,
    // so real runtimes are minutes. Use -profile slurm for full runs (module times apply).
    debug {
        process {
            executor       = 'slurm'
            queue          = 'compute_partners'
            clusterOptions = '-A maize_cpu --qos=short'
            withName: '.*' { time = '1h' }
        }
        executor.queueSize       = 40
        executor.submitRateLimit = '10/1min'
        conda.enabled            = true
    }
    local { process.executor = 'local'; conda.enabled = true }
    // Gate 0: -stub-run touches outputs; no tools, no conda.
    stub  { process.executor = 'local'; conda.enabled = false }
}

process {
    errorStrategy = 'retry'
    maxRetries    = 2          // 3 attempts. ALIGN uses this to escalate memory (24->48->72 GB) on OOM;
                               // a static request that never grew was why retries re-OOM'd before.
    // TMPDIR: compute-node /tmp is a 16 GB local disk (a samtools sort there died at 40 GB written, job 886035,
    // 2026-09-18). Every task gets a per-job scratch dir on /share (GPFS, not persistent = fine for temp); tools
    // that honour TMPDIR (samtools/bcftools sort, GNU sort, Python, R) follow it; Java needs -Djava.io.tmpdir.
    // $SLURM_JOB_ID is empty under the local profile -> falls back to the shell PID.
    beforeScript  = 'source /usr/local/apps/conda/miniconda3/26.3.2/etc/profile.d/conda.sh; ' +
                    'export TMPDIR=/share/maize/$USER/tmp/${SLURM_JOB_ID:-$$}; mkdir -p "$TMPDIR"'
    afterScript   = 'rm -rf "${TMPDIR:-/nonexistent}"'

    // Envs are PREBUILT ONCE ON THE LOGIN NODE (compute nodes have no internet, so Nextflow must NOT
    // build from a yml at task time). Point every label at a prebuilt prefix; rebuild on the login
    // node from the yml when the recipe changes:
    //   conda env create -p /share/maize/frodrig4/conda/env/assembly -f envs/assembly.yml
    withLabel: align  { conda = "/share/maize/frodrig4/conda/env/assembly" }  // minibwa+samtools+cutadapt
    withLabel: call   { conda = "/share/maize/frodrig4/conda/env/assembly" }  // bcftools+htslib
    withLabel: rstats { conda = "/share/maize/frodrig4/conda/env/nilhmm" }    // R + nilhmm (install_github)
    withLabel: qc     { conda = "/share/maize/frodrig4/conda/env/qc" }        // mosdepth + multiqc
}

// conda.enabled is set per-profile (on for slurm/local, off for stub) — NOT globally, so the stub
// run never touches conda.
workDir       = "${params.outdir}/work"

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true
           fields = 'task_id,hash,name,status,exit,cpus,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,realtime,duration' }

manifest {
    name            = 'nilhmm-phase1'
    description     = 'BC1 H_d + BC2S3 binHMM dosage (biallelic bzeaseq sites, B73 v5)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
}
